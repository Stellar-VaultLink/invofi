# ── Supabase ─────────────────────────────────────────────────────────────────
# Project dashboard: https://supabase.com/dashboard/project/ukhxnrlcqmyncjoericr
NEXT_PUBLIC_SUPABASE_URL=https://ukhxnrlcqmyncjoericr.supabase.co

# Your Supabase API key — use whichever name your dashboard shows.
# Older dashboard: Settings → API → "anon / public" key
# Newer dashboard: Settings → API → "Publishable" key
# Both are the same key; the app accepts either variable name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-or-publishable-key>

# ── Stellar / Soroban ─────────────────────────────────────────────────────────
# Five-contract deployment on Stellar testnet (see README Live Demo).
# The frontend wires registry / financing / repayment; insurance and
# reputation are deployed contracts reached only cross-contract.
#   registry   — invoices, admin, pause, rates
#   financing  — offers, accept/reject, currency registry
#   repayment  — repay, mark overdue, reclaim
# Deploy your own via the invofi-contracts "Deploy Contracts to Testnet"
# workflow and replace these IDs.
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=CAXNTWSKDVSB3GPJMU3RTSDTAIFF4A6FFRAAI35B4AE7LZLLI4VXMCF7
NEXT_PUBLIC_FINANCING_CONTRACT_ID=CBGRA3457ZFXYZNEQLO4YGUQ3OBEWOE6US6ZREHK6NF2DLZYBO73IFVW
NEXT_PUBLIC_REPAYMENT_CONTRACT_ID=CCDATW5GMVDOPK55Q4MLXV5SGA3VLXPD67ABLBNMHWFF6BLL2IZBUVEP

# Position token: SEP-41 Stellar asset (POS) minted to lenders on offer
# acceptance. Defaults to the live testnet POS asset if unset.
# NEXT_PUBLIC_POSITION_TOKEN_ASSET=POS:GBDDLOWR6YUEEYUKFKS6ISTCLBQKDPUXAOVJMNJYAACT6UYQGEKYEVZR

# Legacy single-contract mode: if the three variables above are unset, the app
# falls back to NEXT_PUBLIC_CONTRACT_ID (all calls route to that one contract).
# NEXT_PUBLIC_CONTRACT_ID=CDS3WO5K6GUBGCLMRUR4IQYLDT5SNDOMUMZFDXOMXYP6EELLTM5MMALH

NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional: USDC issuer on testnet
# NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# ── Sentry (Optional) ─────────────────────────────────────────────────────────
# Error monitoring. Optional for local dev; required for production monitoring.
# Get your DSN from https://sentry.io/settings/projects/your-project/keys/
# NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# Build-time only (Vercel CI):
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=your-auth-token
