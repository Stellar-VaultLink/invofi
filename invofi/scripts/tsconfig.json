{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "keeper.ts",
    "keeper.test.ts",
    "e2e-onchain.ts",
    "health-collector.ts",
    "health-collector.test.ts",
    "invoice-reminders.ts",
    "invoice-reminders.test.ts"
  ]
}